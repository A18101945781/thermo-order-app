/* 菜品详情页样式 */
.page {
  min-height: 100vh;
  background: var(--bg-color, #F5F5F5);
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* SOP 录入模式顶部标识 */
.sop-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #FFF1F1 0%, #FFE4E4 100%);
  border-radius: var(--radius, 16rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid var(--primary-color, #FA5151);
}

.sop-banner-icon {
  font-size: 48rpx;
}

.sop-banner-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sop-banner-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary-color, #FA5151);
}

.sop-banner-desc {
  font-size: var(--font-sm, 22rpx);
  color: #C74848;
}

/* 头部菜品信息 */
.dish-header {
  background: var(--card-bg, #FFFFFF);
  border-radius: var(--radius, 16rpx);
  box-shadow: var(--shadow, 0 4rpx 16rpx rgba(0,0,0,0.06));
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.dish-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.dish-name {
  font-size: var(--font-xl, 36rpx);
  font-weight: 700;
  color: var(--text-primary, #333333);
}

.dish-name-input {
  flex: 1;
  font-size: var(--font-xl, 36rpx);
  font-weight: 700;
  color: var(--text-primary, #333333);
  border-bottom: 2rpx solid #FA5151;
  padding-bottom: 8rpx;
}

/* 套餐类型选择 */
.dish-type-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.edit-label-inline {
  font-size: var(--font-sm, 24rpx);
  color: var(--text-secondary, #999999);
  margin-right: 8rpx;
}

.type-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.type-tag {
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-size: var(--font-sm, 24rpx);
  background: #F5F5F5;
  color: #666666;
  border: 2rpx solid transparent;
}

.type-tag.active {
  background: rgba(250, 81, 81, 0.1);
  color: #FA5151;
  border-color: #FA5151;
  font-weight: 600;
}

.dish-price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.price-label {
  font-size: var(--font-sm, 24rpx);
  color: var(--text-secondary, #999999);
}

.price-value {
  font-size: var(--font-xl, 36rpx);
  font-weight: 700;
  color: var(--primary-color, #FA5151);
}

.price-input {
  font-size: var(--font-xl, 36rpx);
  font-weight: 700;
  color: var(--primary-color, #FA5151);
  border-bottom: 2rpx solid #FA5151;
  padding-bottom: 4rpx;
  width: 200rpx;
}

/* 分区标题 */
.section {
  background: var(--card-bg, #FFFFFF);
  border-radius: var(--radius, 16rpx);
  box-shadow: var(--shadow, 0 4rpx 16rpx rgba(0,0,0,0.06));
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: var(--font-lg, 32rpx);
  font-weight: 600;
  color: var(--text-primary, #333333);
  margin-bottom: 20rpx;
  display: block;
}

/* BOM 表格 */
.bom-table {
  width: 100%;
}

.bom-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.bom-header {
  background: #FAFAFA;
  border-radius: 8rpx;
  font-weight: 600;
  color: var(--text-secondary, #999999);
  font-size: var(--font-sm, 24rpx);
  padding: 12rpx 0;
}

.bom-col {
  font-size: var(--font-sm, 24rpx);
  color: var(--text-primary, #333333);
}

.col-name { flex: 2; }
.col-num { flex: 1; text-align: center; }
.col-price { flex: 1.5; text-align: center; }
.col-unit { flex: 1; text-align: center; }
.col-cost { flex: 1.5; text-align: center; color: var(--primary-color, #FA5151); }
.col-action { width: 60rpx; text-align: center; }

/* 删用料按钮（原来是 t-icon name="delete"，字体加载失败 → 图标看不见，不知道点哪）
   换成文字 ✕，并给足点击区（否则手指点不准） */
.bom-del {
  display: inline-block;
  min-width: 56rpx;
  padding: 6rpx 0;
  font-size: 32rpx;
  line-height: 1;
  color: var(--primary-color, #FA5151);
}

/* BOM 用量输入框（NumberInput） */
.bom-num-input {
  flex: 1;
  margin: 0 4rpx;
}

.bom-num-input .number-input-wrap {
  width: 100%;
  height: 48rpx;
  border-radius: 8rpx;
  border: 2rpx solid #E5E5E5;
  background: #FAFAFA;
}

.bom-num-input .number-input-wrap.focused {
  border-color: #FA5151;
  background: #FFFFFF;
}

.bom-num-input .num-input {
  height: 44rpx;
  font-size: var(--font-sm, 24rpx);
  text-align: center;
  color: var(--text-primary, #333333);
}

.bom-add-row {
  padding: 20rpx 0;
  text-align: center;
}

.bom-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--text-secondary, #999999);
}

/* 成本汇总网格 */
.summary-grid {
  display: flex;
  flex-wrap: wrap;
}

.summary-item {
  width: 50%;
  padding: 16rpx 0;
}

.summary-label {
  font-size: var(--font-sm, 24rpx);
  color: var(--text-secondary, #999999);
  display: block;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: var(--font-lg, 32rpx);
  font-weight: 600;
  color: var(--text-primary, #333333);
}

.summary-value.price {
  color: var(--primary-color, #FA5151);
}

.summary-value.rate {
  color: #4CAF50;
}

/* 编辑操作栏 */
.edit-bar {
  background: var(--card-bg, #FFFFFF);
  border-radius: var(--radius, 16rpx);
  box-shadow: var(--shadow, 0 4rpx 16rpx rgba(0,0,0,0.06));
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.edit-item {
  margin-bottom: 20rpx;
}

.edit-label {
  font-size: var(--font-sm, 24rpx);
  color: var(--text-secondary, #999999);
  display: block;
  margin-bottom: 8rpx;
}

.edit-actions {
  display: flex;
  gap: 16rpx;
}

/* 添加原料弹出层：面板高度由全局 .dlg-panel(88vh) 控制，此处只负责「撑满 + 内部滚动」
   2026-10-01：原来只有 max-height、没有确定高度 → scroll-view 不滚动、内容顶破面板。 */
.popup-content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 28rpx 24rpx 0;
}

.popup-title {
  font-size: var(--font-lg, 32rpx);
  font-weight: 600;
  color: var(--text-primary, #333333);
  margin-bottom: 20rpx;
  text-align: center;
}

.popup-search {
  margin-bottom: 20rpx;
}

/* scroll-view 需要「确定的父级高度」才会滚 → flex:1 + min-height:0 */
.popup-scroll {
  flex: 1;
  min-height: 0;
}

.popup-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.popup-item-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.popup-item-name {
  font-size: var(--font-base, 28rpx);
  color: var(--text-primary, #333333);
}

.popup-item-unit {
  font-size: var(--font-xs, 20rpx);
  color: var(--text-secondary, #999999);
  background: #F5F5F5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.popup-item-price {
  font-size: var(--font-base, 28rpx);
  color: var(--primary-color, #FA5151);
  font-weight: 600;
}

.popup-empty {
  padding: 60rpx;
  text-align: center;
  color: var(--text-secondary, #999999);
}

/* 关闭按钮钉在面板底部，不随列表滚动 */
.popup-close {
  flex-shrink: 0;
  padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  text-align: center;
  border-top: 1rpx solid #F5F5F5;
  background: #fff;
}

/* ==================== 营养成分区块 ==================== */
.nutri-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.nutri-head .section-title {
  margin-bottom: 0;
}
.nutri-gram {
  font-size: var(--font-sm, 24rpx);
  color: var(--text-secondary, #999999);
}

.nutri-table {
  border: 1rpx solid var(--border-color, #EEEEEE);
  border-radius: 12rpx;
  overflow: hidden;
}
.nutri-row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid var(--border-color, #F5F5F5);
  font-size: var(--font-sm, 26rpx);
  color: var(--text-primary, #333333);
}
.nutri-row:last-child {
  border-bottom: none;
}
.nutri-header {
  background: var(--bg-gray, #FAFAFA);
  font-size: var(--font-xs, 24rpx);
  color: var(--text-secondary, #999999);
  font-weight: 500;
}
.nutri-col {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.col-item { flex: 2; }
.col-val  { flex: 2; text-align: right; }
.col-nrv  { flex: 1; text-align: right; color: var(--text-secondary, #999999); }
.nutri-col.strong {
  font-weight: 600;
  color: var(--brand-color, #E54D42);
}

/* 供能比条 */
.nutri-ratio {
  margin-top: 24rpx;
}
.ratio-label {
  font-size: var(--font-xs, 24rpx);
  color: var(--text-secondary, #999999);
  display: block;
  margin-bottom: 12rpx;
}
.ratio-bar {
  display: flex;
  height: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: var(--bg-gray, #F0F0F0);
}
.ratio-seg { height: 100%; }
.seg-protein { background: #4C6FB1; }
.seg-fat     { background: #ED7B2F; }
.seg-cho     { background: #07C160; }

.ratio-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}
.legend-item {
  font-size: var(--font-xs, 22rpx);
  color: var(--text-secondary, #666666);
  display: flex;
  align-items: center;
}
.legend-item .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  display: inline-block;
}

/* 解读提示 */
.nutri-tips {
  margin-top: 24rpx;
}
.tip-line {
  font-size: var(--font-xs, 24rpx);
  line-height: 1.7;
  padding-left: 24rpx;
  position: relative;
}
.tip-line::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}
.tip-ok      { color: var(--text-secondary, #666666); }
.tip-ok::before   { background: #07C160; }
.tip-info    { color: #4C6FB1; }
.tip-info::before { background: #4C6FB1; }
.tip-warn    { color: #E54D42; }
.tip-warn::before { background: #E54D42; }

.nutri-missing {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: #FFF7E6;
  border-radius: 8rpx;
  font-size: var(--font-xs, 22rpx);
  color: #D46B08;
  line-height: 1.6;
}

/* 明细展开 */
.nutri-toggle {
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--font-xs, 24rpx);
  color: var(--brand-color, #E54D42);
  padding: 12rpx 0;
}
.nutri-detail {
  border: 1rpx solid var(--border-color, #EEEEEE);
  border-radius: 12rpx;
  overflow: hidden;
}
.col-dn { flex: 3; }
.col-dg { flex: 2; text-align: right; }
.col-de { flex: 2; text-align: right; }
.col-dp { flex: 2; text-align: right; }
.col-df { flex: 2; text-align: right; }
.est-mark {
  color: #D46B08;
  font-size: 20rpx;
}
.nutri-note {
  padding: 16rpx 20rpx;
  background: var(--bg-gray, #FAFAFA);
  font-size: 20rpx;
  color: var(--text-secondary, #999999);
  line-height: 1.6;
}
