/* 首页导航样式 */
.page {
  min-height: 100vh;
  background: var(--bg-color, #F5F5F5);
  padding: 0 24rpx 40rpx;
}

/* 顶部状态栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.mode-badge {
  font-size: var(--font-sm, 24rpx);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.mode-badge.cloud {
  background: #E3F2FD;
  color: #1976D2;
}

.mode-badge.local {
  background: #FFF3E0;
  color: #E65100;
}

.role-badge {
  font-size: var(--font-sm, 24rpx);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #FFEBEE;
  color: var(--primary-color, #FA5151);
}

/* 欢迎区域 */
.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}

.welcome-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.welcome-title {
  font-size: var(--font-xl, 36rpx);
  font-weight: 700;
  color: var(--text-primary, #333333);
}

.welcome-subtitle {
  font-size: var(--font-sm, 24rpx);
  color: var(--text-secondary, #999999);
  margin-top: 8rpx;
}

/* 功能卡片网格 - 两列 */
.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.nav-card {
  width: calc(50% - 10rpx);
  background: var(--card-bg, #FFFFFF);
  border-radius: var(--radius, 16rpx);
  box-shadow: var(--shadow, 0 4rpx 16rpx rgba(0,0,0,0.06));
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.card-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: var(--font-lg, 32rpx);
  font-weight: 600;
  color: var(--text-primary, #333333);
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: var(--font-xs, 20rpx);
  color: var(--text-secondary, #999999);
}

/* 卡片底色微调 */
.card-1 { border-top: 6rpx solid #FF6B6B; }
.card-2 { border-top: 6rpx solid #4ECDC4; }
.card-3 { border-top: 6rpx solid #FFD93D; }
.card-4 { border-top: 6rpx solid #6C5CE7; }

/* 加载占位 */
.boot-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.boot-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.boot-text {
  font-size: var(--font-sm, 24rpx);
  color: var(--text-secondary, #999999);
}

/* 底部个人中心入口 */
.bottom-nav {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
}

.bottom-nav-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 48rpx;
  background: var(--card-bg, #FFFFFF);
  border-radius: var(--radius, 16rpx);
  box-shadow: var(--shadow, 0 4rpx 16rpx rgba(0,0,0,0.06));
}

.bottom-nav-icon {
  font-size: 40rpx;
}

.bottom-nav-icon-img {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F5F5F5;
  flex-shrink: 0;
}

.bottom-nav-text {
  font-size: var(--font-base, 28rpx);
  color: var(--text-primary, #333333);
}
