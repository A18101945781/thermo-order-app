.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 说明卡 */
.tip-card {
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}
.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ad6800;
  margin-bottom: 8rpx;
}
.tip-line {
  font-size: 24rpx;
  color: #874d00;
  line-height: 38rpx;
}

/* 套餐卡 */
.meal-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.meal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.meal-title {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.meal-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #262626;
}
.badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #fa5151;
  background: #fff1f0;
  border: 1rpx solid #ffccc7;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.meal-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #fa5151;
}

/* 查看态行 */
.dish-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #f5f5f5;
}
.dish-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dish-name.missing {
  color: #fa5151;
}
.dish-qty {
  width: 90rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}
.dish-cost {
  width: 120rpx;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}

.meal-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #fafafa;
  border-radius: 10rpx;
}
.foot-item {
  font-size: 24rpx;
  color: #595959;
}

/* 按钮 */
.btn-row {
  display: flex;
  margin-top: 20rpx;
}
.btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 27rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
}
.btn:last-child {
  margin-right: 0;
}
.btn-main {
  background: #fa5151;
  color: #fff;
}
.btn-plain {
  background: #fff;
  color: #595959;
  border: 1rpx solid #d9d9d9;
}

/* 编辑态行 */
.edit-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.edit-name {
  flex: 1;
  font-size: 26rpx;
  color: #262626;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.qty-box {
  display: flex;
  align-items: center;
  margin: 0 12rpx;
}
.qty-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 30rpx;
  color: #595959;
  background: #f5f5f5;
  border-radius: 8rpx;
}
.qty-val {
  width: 56rpx;
  text-align: center;
  font-size: 27rpx;
  color: #262626;
}
.row-act {
  width: 60rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 24rpx;
  color: #1677ff;
  background: #f0f7ff;
  border-radius: 8rpx;
  margin-left: 10rpx;
}
.row-act.del {
  color: #fa5151;
  background: #fff1f0;
}

.edit-foot {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #f6ffed;
  border-radius: 10rpx;
}
.ef-text {
  font-size: 24rpx;
  color: #389e0d;
}

.empty {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 80rpx 0;
}
.safe-bottom {
  height: 40rpx;
}

/* 选菜弹窗 */
/* 面板高度自适应：覆盖全局 .dlg-panel 的 88vh（本页内容 .picker 自带 max-height:76vh，
   若沿用定高会在底部留一块空白）。双类选择器保证特异性高过全局单类。 */
.dlg-panel.picker-panel { height: auto; }

.picker {
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  padding: 24rpx;
  max-height: 76vh;
  box-sizing: border-box;
}
.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.ph-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #262626;
}
.ph-close {
  font-size: 26rpx;
  color: #999;
}
.picker-search {
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  margin: 20rpx 0;
}
.picker-list {
  height: 56vh;
}
.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.pi-name {
  flex: 1;
  font-size: 27rpx;
  color: #262626;
}
.pi-cost {
  font-size: 23rpx;
  color: #999;
}
.picker-empty {
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
  padding: 60rpx 0;
}
