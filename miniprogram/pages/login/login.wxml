<!-- 微信授权登录页 — 纯本地模式 -->
<view class="page">
  <view class="safe-top" />

  <!-- Logo -->
  <view class="logo-section">
    <text class="logo-icon">🌡️</text>
    <text class="logo-title">热力学餐厅</text>
    <text class="logo-subtitle">订货管理系统</text>
  </view>

  <!-- 步骤1: 登录按钮 -->
  <view class="login-section" wx:if="{{step === 'login'}}">
    <view class="login-btn" bindtap="onWxLogin">
      <text class="login-btn-text">微信一键登录</text>
    </view>
  </view>

  <!-- 步骤2: 角色选择 -->
  <view class="login-section" wx:if="{{step === 'role'}}">
    <view class="authorized-tip">
      <text class="auth-icon">✓</text>
      <text class="auth-text">授权成功，请选择角色</text>
    </view>

    <view class="role-list">
      <view class="role-card {{selectedRole === 'boss' ? 'active' : ''}}" bindtap="onSelectRole" data-role="boss">
        <text class="role-icon">👔</text>
        <text class="role-name">鲍勃</text>
        <text class="role-desc">老板 · 全部权限</text>
        <view class="role-perms">
          <text class="perm-tag">全部功能</text>
          <text class="perm-tag">编辑管理</text>
          <text class="perm-tag">查看报表</text>
        </view>
      </view>

      <view class="role-card {{selectedRole === 'purchase' ? 'active' : ''}}" bindtap="onSelectRole" data-role="purchase">
        <text class="role-icon">🛒</text>
        <text class="role-name">采购</text>
        <text class="role-desc">采购员 · 订货+查看</text>
        <view class="role-perms">
          <text class="perm-tag">订货管理</text>
          <text class="perm-tag">查看原料</text>
          <text class="perm-tag">查看报表</text>
        </view>
      </view>

      <view class="role-card {{selectedRole === 'kitchen' ? 'active' : ''}}" bindtap="onSelectRole" data-role="kitchen">
        <text class="role-icon">👨‍🍳</text>
        <text class="role-name">后厨</text>
        <text class="role-desc">厨师 · 仅查看</text>
        <view class="role-perms">
          <text class="perm-tag">查看菜品</text>
          <text class="perm-tag">查看原料</text>
        </view>
      </view>
    </view>

    <view class="confirm-btn {{selectedRole ? 'active' : ''}}" bindtap="onConfirmRole">
      <text class="confirm-btn-text">确认进入</text>
    </view>
  </view>

  <view class="privacy-notice">
    <text class="privacy-text">登录即表示同意《用户协议》和《隐私政策》</text>
    <text class="privacy-text">本系统为本地缓存存储，不涉及云端数据</text>
  </view>

  <view class="safe-bottom" />
<scroll-anchor show="{{showScrollAnchor}}" progress="{{scrollProgress}}" bind:totop="onScrollAnchorTop" />
</view>
