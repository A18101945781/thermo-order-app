/* 菜品菜单页样式 */
.page {
  min-height: 100vh;
  background: var(--bg-color, #F5F5F5);
  padding-bottom: 120rpx;
}

/* 启动占位 */
.boot-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.boot-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.boot-text {
  font-size: var(--font-base, 28rpx);
  color: var(--text-secondary, #999999);
}

/* 二态切换 tab-row */
.tab-row {
  display: flex;
  padding: 24rpx 24rpx 16rpx;
  gap: 16rpx;
  background: var(--bg-color, #F5F5F5);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  font-size: var(--font-base, 28rpx);
  color: var(--text-secondary, #666666);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
}

.tab-item.active {
  background: var(--primary-color, #FA5151);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(250,81,81,0.3);
}

.tab-icon {
  font-size: 32rpx;
}

.tab-count {
  font-size: var(--font-sm, 22rpx);
  background: rgba(255,255,255,0.25);
  color: inherit;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 4rpx;
}

.tab-item:not(.active) .tab-count {
  background: rgba(0,0,0,0.06);
}

/* 搜索栏外容器 */
.search-wrapper {
  padding: 16rpx 24rpx;
}

/* 分类快捷筛选条（2026-10-02）：横向滚动芯片，选中红底白字 */
.cat-filter {
  padding: 0 0 8rpx;
}

.cat-scroll {
  width: 100%;
  white-space: nowrap;
  padding: 4rpx 20rpx 8rpx;
  box-sizing: border-box;
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 22rpx;
  margin-right: 12rpx;
  background: #FFFFFF;
  border: 2rpx solid #EBEBEB;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #666666);
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.03);
  transition: all 0.18s;
}

.cat-chip.active {
  background: var(--primary-color, #FA5151);
  border-color: var(--primary-color, #FA5151);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(250,81,81,0.28);
}

.cat-chip-name {
  font-weight: 500;
  line-height: 1;
}

.cat-chip-count {
  font-size: 20rpx;
  line-height: 1;
  padding: 2rpx 10rpx;
  margin-left: 8rpx;
  border-radius: 18rpx;
  background: rgba(0,0,0,0.05);
  color: inherit;
}

.cat-chip.active .cat-chip-count {
  background: rgba(255,255,255,0.28);
}

/* 菜品卡片网格 - 两列 */
.dish-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
  gap: 16rpx;
}

.dish-grid-item {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
}

/* 菜单分类头（经典主食 / 西式主食 / 现煮面食 / 缤纷小食） */
.cat-head {
  width: 100%;
  box-sizing: border-box;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary-color, #FA5151);
  background: #FFF5F5;
  border-left: 8rpx solid var(--primary-color, #FA5151);
  padding: 16rpx 20rpx;
  margin: 12rpx 0 4rpx;
  border-radius: 8rpx;
}

.cat-head-grid {
  width: 100%;
}

/* 套餐两列布局:左团队 / 右单人,按价格升序对齐 */
.meal-rows {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meal-row {
  display: flex;
  gap: 12rpx;
  align-items: stretch;
}

.meal-cell {
  flex: 1;
  min-width: 0;
  display: flex;
}

/* 单人套餐占位块:无数据时显示虚线"预留",保持左卡片半宽不撑满 */
.meal-slot-placeholder {
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  border: 2rpx dashed #D8D8D8;
  border-radius: var(--radius, 16rpx);
  background: #FAFAFA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-text {
  font-size: 22rpx;
  color: #BFBFBF;
}

/* 分类标签(团队/单人) */
.meal-tag {
  font-size: 18rpx;
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  align-self: flex-start;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.tag-team {
  background: #FFE8D6;
  color: #C44A2F;
}

.tag-single {
  background: #D6F0DB;
  color: #2A7B3A;
}

.meal-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: transform 0.15s;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.meal-card:active {
  transform: scale(0.98);
}

.meal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  gap: 8rpx;
}

.meal-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #333333);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meal-cat {
  font-size: var(--font-sm, 20rpx);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.cat-team {
  background: #FFF1F1;
  color: var(--primary-color, #FA5151);
}

.cat-single {
  background: #E8F4FF;
  color: #1989FA;
}

.meal-desc {
  font-size: var(--font-sm, 22rpx);
  color: var(--text-secondary, #666666);
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.meal-price-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #F0F0F0;
  margin-top: auto;
}

.meal-price-label {
  font-size: var(--font-sm, 20rpx);
  color: var(--text-secondary, #999999);
}

.meal-price {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-color, #FA5151);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: var(--font-base, 28rpx);
  color: var(--text-secondary, #999999);
}

.empty-desc {
  font-size: var(--font-sm, 24rpx);
  color: var(--text-secondary, #999999);
  margin-top: 8rpx;
}

/* 加载中 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.loading-text {
  font-size: var(--font-sm, 24rpx);
  color: var(--text-secondary, #999999);
  margin-top: 16rpx;
}

/* CSS 转圈（原来是 t-icon name="loading"：远程字体加载失败 → 一片空白）2026-10-01 */
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #FFE0E0;
  border-top-color: var(--primary-color, #FA5151);
  border-radius: 50%;
  animation: lspin .8s linear infinite;
}
@keyframes lspin { to { transform: rotate(360deg); } }

/* 双悬浮操作按钮 */
.fab-group {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 24rpx;
  z-index: 100;
}

.fab {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--primary-color, #FA5151);
  box-shadow: 0 8rpx 24rpx rgba(250, 81, 81, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-secondary {
  background: #FFFFFF;
  border: 2rpx solid var(--primary-color, #FA5151);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.08);
  width: auto;
  height: 80rpx;
  border-radius: 40rpx;
  padding: 0 24rpx;
}

.fab-label {
  font-size: var(--font-sm, 24rpx);
  color: var(--primary-color, #FA5151);
  font-weight: 600;
  white-space: nowrap;
}

/* FAB 加号：原 t-icon name="add" 渲染为空白红圆（看不出是什么），改原生文字 2026-10-01 */
.fab-plus {
  color: #FFFFFF;
  font-size: 64rpx;
  line-height: 1;
  margin-top: -6rpx;
}
.fab-hover { opacity: .82; transform: scale(.94); }