/* OrderSummary 订单汇总弹窗样式 */

/* 遮罩层 */
.order-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
}

/* 弹窗主体 */
.order-popup {
  width: 100%;
  max-height: 90vh;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 标题栏 */
.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.popup-close {
  font-size: 36rpx;
  color: #999999;
  padding: 8rpx;
}

/* 滚动内容区 */
.popup-body {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 32rpx;
}

/* 供应商区块 */
.supplier-section {
  margin-bottom: 32rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  padding: 20rpx;
}

.supplier-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #E5E5E5;
}

.supplier-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FA5151;
}

.supplier-count {
  font-size: 24rpx;
  color: #999999;
}

/* 原料明细表 */
.supplier-table {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
}

/* 表头 */
.st-header {
  display: flex;
  background-color: #F5F5F5;
  border-bottom: 2rpx solid #E5E5E5;
}

.st-header .st-col {
  font-size: 22rpx;
  font-weight: 600;
  color: #666666;
  padding: 12rpx 4rpx;
}

/* 列定义 */
.st-col {
  flex-shrink: 0;
  padding: 10rpx 4rpx;
  font-size: 22rpx;
  color: #333333;
  text-align: center;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.st-col-name { width: 150rpx; }
.st-col-price { width: 110rpx; }
.st-col-usage { width: 130rpx; }
.st-col-stock { width: 130rpx; }
.st-col-suggest { width: 130rpx; }
.st-col-amount { width: 120rpx; }

/* 数据行 */
.st-row {
  display: flex;
  border-bottom: 1rpx solid #F0F0F0;
}

.st-row:last-child {
  border-bottom: none;
}

/* 库存不足警告 */
.stock-warn {
  color: #FA5151;
  font-weight: 600;
}

/* 建议采购数 */
.suggest-amount {
  color: #FA5151;
  font-weight: 600;
}

.suggest-zero {
  color: #07C160;
}

/* 供应商小计 */
.supplier-subtotal {
  text-align: right;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  background-color: #FFFFFF;
  border-radius: 0 0 12rpx 12rpx;
}

/* 底部汇总 */
.popup-footer {
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #F0F0F0;
  background-color: #FFFFFF;
}

.footer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.footer-label {
  font-size: 26rpx;
  color: #666666;
}

.footer-value {
  font-size: 26rpx;
  color: #333333;
}

.loss-rate {
  color: #FF9900;
  font-weight: 500;
}

.total-row {
  padding-top: 16rpx;
  border-top: 2rpx solid #F0F0F0;
  margin-bottom: 24rpx;
}

.total-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.total-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #FA5151;
}

/* 操作按钮 */
.footer-actions {
  display: flex;
  gap: 24rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-cancel {
  background-color: #F5F5F5;
  color: #666666;
}

.btn-confirm {
  background-color: #FA5151;
  color: #FFFFFF;
}
