/* NumberInput 数字输入组件样式（纯输入框版） */

.number-input-wrap {
  display: flex;
  align-items: center;
  border: 2rpx solid #E5E5E5;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #FFFFFF;
  width: 140rpx;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.number-input-wrap.focused {
  border-color: #FA5151;
}

/* 输入框 */
.num-input {
  flex: 1;
  height: 64rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333333;
  padding: 0;
  box-sizing: border-box;
  background-color: #FFFFFF;
  font-weight: 500;
}

.num-input::placeholder {
  color: #CCCCCC;
  font-size: 26rpx;
  font-weight: 400;
}
